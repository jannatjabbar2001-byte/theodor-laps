ENVIRONMENT=
FRONTEND_ORIGIN=
# Supabase Project URL. Server-only.
SUPABASE_URL=
# Supabase service-role key. Server-only; never put it in Flutter or an APK.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Postgres pooler connection string. Server-only.
DATABASE_URL=
# Generate a long random value for signing the backend session token.
JWT_SECRET=
# Cloudflare R2 S3-compatible endpoint and credentials. Server-only.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
